name: Sync CDL Data

on:
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: setup-node@v4
        with:
          node-version: 18

      - name: Install dependencies
        run: npm install axios cheerio

      - name: Scrape CDL
        run: |
          node -e "
          const axios = require('axios');
          const cheerio = require('cheerio');
          const fs = require('fs');

          async function sync() {
            try {
              const res = await axios.get('https://liquipedia.net/callofduty/Call_of_Duty_League/2025', {
                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }
              });
              const dataset = { lastUpdate: new Date().toISOString(), status: 'online' };
              fs.writeFileSync('cdl-data.json', JSON.stringify(dataset, null, 2));
              console.log('OK');
            } catch (e) {
              console.error(e.message);
            }
          }
          sync();
          "

      - name: Commit & Push
        run: |
          git config --global user.name "CDL-Bot"
          git config --global user.email "bot@cdlhub.local"
          git add cdl-data.json
          git diff --staged --quiet || (git commit -m "Auto-update CDL Data [skip ci]" && git push)
