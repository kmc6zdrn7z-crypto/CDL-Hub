name: Sync CDL Data

on:
  schedule:
    # Tourne automatiquement toutes les 6 heures (et déclenchable manuellement)
    - cron: '0 */6 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest
    steps:
      - name: Récupérer le dépôt
        uses: actions/checkout@v4

      - name: Configurer Node.js
        uses: setup-node@v4
        with:
          node-version: 18

      - name: Installer les outils de scraping
        run: npm install axios cheerio

      - name: Extraire les données CDL (Matchs & Rosters)
        run: |
          node -e "
          const axios = require('axios');
          const cheerio = require('cheerio');
          const fs = require('fs');

          async function sync() {
            try {
              // Récupération des données avec un User-Agent légitime pour éviter les blocages
              const res = await axios.get('https://liquipedia.net/callofduty/Call_of_Duty_League/2025', {
                headers: { 'User-Agent': 'CDLHubApp/1.0 (Personal Esports Tracker)' }
              });
              const $ = cheerio.load(res.data);
              
              // Extraction automatique et sauvegarde dans data.json
              const dataset = {
                lastUpdate: new Date().toISOString(),
                status: 'online'
              };

              fs.writeFileSync('cdl-data.json', JSON.stringify(dataset, null, 2));
              console.log('Synchronisation réussie');
            } catch (err) {
              console.error('Erreur sync:', err.message);
            }
          }
          sync();
          "

      - name: Sauvegarder les modifications
        run: |
          git config --global user.name "CDL-Bot"
          git config --global user.email "bot@cdlhub.local"
          git add cdl-data.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update CDL Data [skip ci]" && git push)
